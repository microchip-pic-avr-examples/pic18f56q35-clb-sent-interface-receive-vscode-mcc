    out[1] <= out[0];\n        out[2] <= out[1];\n        out[3] <= out[2];\n        out[4] <= out[3];\n        out[5] <= out[4];\n        out[6] <= out[5];\n        out[7] <= out[6];\n      end\n  end\n      assign bit_6 = out[2];\n      assign bit_7 = out[7];\n\nendmodule"}],"entryFile":"main","settings":[{"name":"clkdiv","value":"DIV1"}]}